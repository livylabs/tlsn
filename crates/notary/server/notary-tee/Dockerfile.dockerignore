# Docker ignore file for notary-server build
# Ignore build artifacts
target/
**/target/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore Git
.git/
.gitignore

# Ignore documentation
*.md
docs/

# Ignore test files
# (Keep tests in the Docker build context so workspace manifests that reference
# them don't fail to parse.)

# Ignore CI/CD
.github/
.gitlab-ci.yml

# Ignore local config
.env
.env.*
*.local

# Ignore temporary files
tmp/
temp/
*.tmp

