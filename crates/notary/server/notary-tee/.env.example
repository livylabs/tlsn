# TLSN Proxy Configuration
# Copy this file to .env and modify as needed

# Address and port for the proxy to listen on
TLSN_PROXY_LISTEN=0.0.0.0:7048

# Upstream notary server URL
TLSN_PROXY_UPSTREAM=http://127.0.0.1:7047

# Directory to store job artifacts (requests, responses, quotes, metadata)
TLSN_PROXY_JOBS_DIR=/tmp/tlsn-proxy

# Maximum body size in bytes (default: 10MB)
TLSN_PROXY_MAX_BODY_BYTES=10485760

# TDX attestation command template
# Use {reportdata} and {output} as placeholders
# Note: Value must be quoted because it contains spaces
TLSN_PROXY_TDX_CMD="sudo trustauthority-cli evidence --tdx -u '{reportdata_b64}' --output '{output}'"

# Optional: Domain string for reportdata commit (default: "TLSN_TDX_V1")
TLSN_PROXY_REPORTDATA_DOMAIN=TLSN_TDX_V1
